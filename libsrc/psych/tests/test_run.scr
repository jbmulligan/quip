max_warnings 1

Define Trial1 0
advise "Trial1 xval = $xval   class = $class"
.

Vector xvals 21 1 float
Ramp1D xvals 0 -0.1

experiments
  import_xvals xvals
  classes
    new class1 Trial1
    quit
  Set response_string "x value greater than -1.4"
  parameters
    staircases
      change n_updn 1
      quit
    trials
      change n_data 20
      quit
    quit
  advise "Presenting test stimulus"
  present_stim staircase.class1.0
  advise "Presenting test trial"
  present_trial class1 0 yes

  save foo_dribble1
  advise "Initializing trial block..."
  init_block
  use_keyboard yes
  run
  advise "Saving data"
  save foo_dribble2
  exit
